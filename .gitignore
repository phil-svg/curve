# secrets — never commit
.env

# local agent rules, not part of the site
AGENT_RULES.txt

# local research + dev tooling, not part of the site
research/
dev/

# datasets & caches — synced to the server with rsync, never committed
# (GitHub rejects files >100 MB; everything here is fetched or generated).
# The negated entries are small stable assets the UI serves directly.
data/*
!data/favicon.png
!data/landing_torus.png
!data/sldl_table.json
!data/sldl_usd_1m.bin
zchf/*
!zchf/sweep_parameters.py
!zchf/README.md
v1sim_data/
llamma-simulator_v2/data/

# compiled engine binaries — platform-specific build artifacts;
# rebuild from cpp-src/ (see README)
bin/
cpp-implementations/**/build/

# private validation harness (see cpp-implementations/README.md)
cpp-impl/

# regenerated by the server's hourly cycle / manual fetchers
images/
results/

# runtime noise
tmp/
__pycache__/
*.pyc
*.log
.DS_Store

# local Claude Code harness config (launch.json)
.claude/
